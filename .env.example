# Copy to `.env` for local overrides:  cp .env.example .env
#
# `.env` is gitignored. This file is a TEMPLATE and is committed, so it must
# never contain a secret — only variable names with safe placeholder values.
#
# VITE_SITE_URL is the public origin used to build ABSOLUTE social preview URLs.
# Open Graph requires absolute og:image/og:url values; crawlers do not resolve
# relative paths and a relative value silently produces no card at all.
VITE_SITE_URL=https://keepsake.tariq-k-dev.workers.dev
